1\u4e3b\u9875\u7684\u8d26\u53f7\u8d1f\u8d23\u4eba\u3002\u5efa\u8bae\u4f7f\u7528\u7535\u8111\u64cd\u4f5c\u3002\u672c\u6587\u4e2d\u7684\u79f0\u547c\u6cbf\u7528 \u603b\u8bf4\u660e\u3002</p> <p>Facebook \u4e2a\u4eba\u8d26\u53f7\u7528\u4e8e\u767b\u5f55\u548c\u7ba1\u7406\uff1bFacebook \u516c\u5171\u4e3b\u9875\u7528\u4e8e\u5411\u8bbf\u5ba2\u548c\u6f5c\u5728\u4e70\u5bb6\u5c55\u793a\u8d35\u53f8\u3001\u4ea7\u54c1\u548c\u5185\u5bb9\u3002\u8bbf\u5ba2\u770b\u5230\u7684\u662f\u516c\u5171\u4e3b\u9875\uff0c\u4e0d\u4f1a\u56e0\u6b64\u83b7\u5f97\u60a8\u4e2a\u4eba\u8d26\u53f7\u7684\u767b\u5f55\u4fe1\u606f\u3002\u4e2a\u4eba\u4e3b\u9875\u548c\u516c\u5171\u4e3b\u9875\u7684\u533a\u522b</p>"},{"location":"01%E5%88%9B%E5%BB%BA%E5%85%AC%E5%85%B1%E4%B8%BB%E9%A1%B5/#_1","title":"\u521b\u5efa\u524d\u51c6\u5907","text":"<p>\u8bf7\u5148\u51c6\u5907\u4ee5\u4e0b\u5185\u5bb9\uff1a - \u4f01\u4e1a\u6216\u54c1\u724c\u7684\u82f1\u6587\u540d\u79f0\uff1b - \u6700\u80fd\u4ee3\u8868\u4e3b\u8425\u4e1a\u52a1\u7684\u884c\u4e1a\u7c7b\u522b\uff1b - \u4e00\u53e5\u7b80\u77ed\u7684\u82f1\u6587\u4e1a\u52a1\u4ecb\u7ecd\u3002</p> <p>\u4e3b\u9875\u540d\u79f0\u5efa\u8bae\u4e0e\u5b98\u7f51\u3001\u5546\u6807\u548c\u5176\u4ed6\u793e\u5a92\u5e73\u53f0\u4fdd\u6301\u4e00\u81f4\u3002\u4e0d\u8981\u52a0\u5165\u4e0d\u5c5e\u4e8e\u54c1\u724c\u540d\u79f0\u7684\u5ba3\u4f20\u8bcd\u3001\u7b26\u53f7\u6216\u8054\u7cfb\u65b9\u5f0f\uff0c\u4ee5\u514d\u5f71\u54cd\u5ba1\u6838\u548c\u6f5c\u5728\u4e70\u5bb6\u8bc6\u522b\u54c1\u724c\u3002</p>"},{"location":"01%E5%88%9B%E5%BB%BA%E5%85%AC%E5%85%B1%E4%B8%BB%E9%A1%B5/#_2","title":"\u7b2c\u4e00\u6b65\uff1a\u8fdb\u5165\u516c\u5171\u4e3b\u9875\u521b\u5efa\u9875\u9762","text":"<ol> <li>\u767b\u5f55\u60a8\u7684 Facebook \u4e2a\u4eba\u8d26\u53f7\u3002\u6ce8\u518c\u6559\u7a0b</li> <li>\u70b9\u51fb\u53f3\u4e0a\u89d2\u5934\u50cf<ol> <li></li> </ol> </li> <li>\u518d\u70b9\u51fb\u201c\u67e5\u770b\u6240\u6709\u4e2a\u4eba\u4e3b\u9875 / See all profiles\u201d\u3002<ol> <li></li> </ol> </li> <li>\u70b9\u51fb\u201c\u521b\u5efa\u65b0\u516c\u5171\u4e3b\u9875 / Create new Page\u201d\u3002<ol> <li></li> </ol> </li> <li>\u9009\u62e9\u201c\u516c\u5171\u4e3b\u9875\u201d\u540e\uff0c\u70b9\u51fb\u201c\u4e0b\u4e00\u6b65\u201d<ol> <li></li> </ol> </li> <li>\u70b9\u51fb\u201c\u5f00\u59cb\u201d<ol> <li></li> </ol> </li> </ol>"},{"location":"01%E5%88%9B%E5%BB%BA%E5%85%AC%E5%85%B1%E4%B8%BB%E9%A1%B5/#_3","title":"\u7b2c\u4e8c\u6b65\uff1a\u586b\u5199\u516c\u5171\u4e3b\u9875\u4fe1\u606f","text":"<p>\u8bf7\u4f9d\u6b21\u586b\u5199\u4e3b\u9875\u540d\u79f0\u3001\u7c7b\u522b\u548c\u7b80\u4ecb\u3002 1. \u586b\u5199\u4e3b\u9875\u540d\u79f0     1. \u5728\u201c\u516c\u5171\u4e3b\u9875\u540d\u79f0 / Page name\u201d\u4e2d\u8f93\u5165\u4f01\u4e1a\u6216\u54c1\u724c\u540d\u79f0\u3002 2. \u9009\u62e9\u7c7b\u522b     1. \u70b9\u51fb\u201c\u7c7b\u522b / Category\u201d\u3002     2. \u8f93\u5165\u4e0e\u4e3b\u8425\u4e1a\u52a1\u76f8\u5173\u7684\u82f1\u6587\u5173\u952e\u8bcd\u3002     3. \u4ece Facebook \u63d0\u4f9b\u7684\u9009\u9879\u4e2d\u9009\u62e9\u6700\u63a5\u8fd1\u4f01\u4e1a\u5b9e\u9645\u4e1a\u52a1\u7684\u7c7b\u522b\u3002 3. \u586b\u5199\u7b80\u4ecb     1. \u5728\u201c\u7b80\u4ecb / Bio\u201d\u4e2d\uff0c\u7528\u4e00\u53e5\u82f1\u6587\u8bf4\u660e\u8d35\u53f8\u505a\u4ec0\u4e48\u3001\u670d\u52a1\u54ea\u4e9b\u76ee\u6807\u4e70\u5bb6\u3002 </p>"},{"location":"01%E5%88%9B%E5%BB%BA%E5%85%AC%E5%85%B1%E4%B8%BB%E9%A1%B5/#name","title":"\u516c\u5171\u4e3b\u9875\u540d\u79f0(Name)","text":"<p>\u8981\u6c42\uff1a\u5fc5\u987b\u51c6\u786e\u4ee3\u8868\u4e3b\u9875\u5185\u5bb9\u3002\u4e0d\u80fd\u5305\u542b\u8bef\u5bfc\u6027\u8bcd\u6c47\u3001\u8fc7\u591a\u7684\u6807\u70b9\u7b26\u53f7\u6216\u5168\u5927\u5199\u5b57\u6bcd\uff08\u9664\u975e\u662f\u7f29\u5199\uff09\u3002 - \u7981\u6b62\u5305\u542b\u7684\u5185\u5bb9\uff1a     - \u8bef\u7528\u54c1\u724c\u8bcd\uff1a\u4e0d\u80fd\u5305\u542b\u201cFacebook\u201d\u3001\u201cMeta\u201d\u6216\u4efb\u4f55 Meta \u516c\u53f8\u4ea7\u54c1\u7684\u540d\u79f0\u53ca\u5176\u53d8\u4f53\u3002     - \u8bef\u5bfc\u6027\u8bcd\u6c47\uff1a\u5982\u679c\u8be5\u4e3b\u9875\u4e0d\u662f\u54c1\u724c\u7684\u5b98\u65b9\u4ee3\u8868\uff0c\u4e0d\u80fd\u5728\u540d\u79f0\u4e2d\u4f7f\u7528\u201c\u5b98\u65b9\u201d\uff08Official\uff09\u4e00\u8bcd\u3002     - \u63cf\u8ff0\u6027\u5185\u5bb9\uff1a\u540d\u79f0\u4e2d\u4e0d\u80fd\u5305\u542b\u53e3\u53f7\u6216\u8be6\u7ec6\u63cf\u8ff0\uff08\u4f8b\u5982\uff1a\u4e0d\u80fd\u5199\u6210\u201cXX\u5496\u5561     - \u5168\u57ce\u6700\u597d\u559d\u7684\u5496\u5561\u201d\uff09\uff0c\u6b64\u7c7b\u4fe1\u606f\u5e94\u653e\u5728\u201c\u5173\u4e8e\u201d\u90e8\u5206\u3002     - \u7b26\u53f7\u9650\u5236\uff1a\u7981\u6b62\u4f7f\u7528\u7279\u6b8a\u7b26\u53f7\uff08\u5982 \u00ae\uff09\u6216\u4e0d\u5fc5\u8981\u7684\u6807\u70b9\u7b26\u53f7\u3002 - \u547d\u540d\u683c\u5f0f\u9650\u5236\uff1a     - \u7981\u6b62\u5168\u5927\u5199\uff1a\u9664\u7f29\u5199\u5916\uff0c\u4e0d\u80fd\u5168\u90e8\u4f7f\u7528\u5927\u5199\u5b57\u6bcd\u3002     - \u7981\u6b62\u4e0d\u89c4\u8303\u5927\u5c0f\u5199\uff1a\u4e0d\u80fd\u4f7f\u7528\u4e0d\u7b26\u5408\u8bed\u6cd5\u7684\u5927\u5c0f\u5199\uff08\u4f8b\u5982\uff1atHe bEsT cAfE\uff09\u3002     - \u907f\u514d\u8fc7\u4e8e\u5bbd\u6cdb\uff1a\u4e0d\u80fd\u4ec5\u7531\u4e00\u4e2a\u901a\u7528\u8bcd\uff08\u5982\u201cPizza\u201d\uff09\u6216\u4e00\u4e2a\u901a\u7528\u5730\u7406\u4f4d\u7f6e\uff08\u5982\u201cNew York\u201d\uff09\u7ec4\u6210\u3002 \u586b\u5199\u5efa\u8bae\uff1a\u5efa\u8bae\u4f7f\u7528\u201c**\u54c1\u724c\u540d\u201d\u3002 - \u4f8b\u5982\uff1aGooe Yun - \u8fd9\u6837\u53ef\u4ee5\u8ba9\u6f5c\u5728\u4e70\u5bb6\u5728\u641c\u7d22\u4ea7\u54c1\u65f6\u66f4\u5bb9\u6613\u53d1\u73b0\u60a8\uff0c\u5e76\u4e00\u773c\u770b\u51fa\u60a8\u7684\u8eab\u4efd</p>"},{"location":"01%E5%88%9B%E5%BB%BA%E5%85%AC%E5%85%B1%E4%B8%BB%E9%A1%B5/#catagory","title":"\u516c\u5171\u4e3b\u9875\u7c7b\u522b(Catagory)","text":"<p>\u8981\u6c42\uff1a\u6700\u591a\u53ef\u4ee5\u9009\u62e9 3 \u4e2a\u7c7b\u522b\u3002 \u586b\u5199\u5efa\u8bae\uff1a\u7b2c\u4e00\u4e2a\u7c7b\u522b\u6700\u4e3a\u91cd\u8981\uff0c\u5b83\u4f1a\u663e\u793a\u5728\u4e3b\u9875\u540d\u79f0\u4e0b\u65b9\u5e76\u5f71\u54cd\u63a8\u8350\u7b97\u6cd5\u3002 - \u5382\u5bb6\u63a8\u8350\u9009\u62e9\uff1a\u5382\u5bb6 (Manufacturer)\u3001\u5de5\u4e1a\u516c\u53f8 (Industrial Company) \u6216\u6279\u53d1\u5546 (Wholesaler)\u3002 - \u8bf7\u786e\u4fdd\u7c7b\u522b\u4e0e\u60a8\u7684\u5b9e\u9645\u4e1a\u52a1\u9ad8\u5ea6\u76f8\u5173\uff0c\u8fd9\u6709\u52a9\u4e8e\u4e70\u5bb6\u901a\u8fc7\u5206\u7c7b\u641c\u7d22\u627e\u5230\u60a8\u3002</p>"},{"location":"01%E5%88%9B%E5%BB%BA%E5%85%AC%E5%85%B1%E4%B8%BB%E9%A1%B5/#bio","title":"\u4e2a\u6027\u7b7e\u540d(bio)","text":"<p>\u8981\u6c42\uff1a\u9650 255 \u4e2a\u5b57\u7b26\u4ee5\u5185\u3002 \u586b\u5199\u5efa\u8bae\uff1a\u8fd9\u662f\u4e70\u5bb6\u8fdb\u5165\u4e3b\u9875\u540e\u770b\u5230\u7684\u7b80\u77ed\u4ecb\u7ecd\uff0c\u5e94\u5305\u542b\u60a8\u7684\u6838\u5fc3\u4ef7\u503c\u70b9\u3002 - \u6a21\u677f\uff1a\u4e13\u6ce8\u4e8e\u3010\u4ea7\u54c1\u9886\u57df\u3011\u7684\u751f\u4ea7\u5382\u5bb6\uff0c\u62e5\u6709\u3010X\u3011\u5e74\u884c\u4e1a\u7ecf\u9a8c\u3002\u63d0\u4f9b OEM/ODM \u670d\u52a1\uff0c\u6b22\u8fce\u8be2\u76d8\u83b7\u53d6\u76ee\u5f55\u3002 - \u7a81\u51fa\u60a8\u7684\u5de5\u5382\u4f18\u52bf\uff08\u5982\uff1a\u7814\u53d1\u5b9e\u529b\u3001\u8bc1\u4e66\u8ba4\u8bc1\u3001\u51fa\u53e3\u7ecf\u9a8c\uff09\u3002 - </p>"},{"location":"01%E5%88%9B%E5%BB%BA%E5%85%AC%E5%85%B1%E4%B8%BB%E9%A1%B5/#_4","title":"\u7b2c\u4e09\u6b65\uff1a\u5b8c\u6210\u516c\u5171\u4e3b\u9875\u8bbe\u7f6e","text":"<p> \u4e3a\u4e86\u8ba9\u4e3b\u9875\u770b\u8d77\u6765\u66f4\u4e13\u4e1a\u5e76\u63d0\u9ad8\u53ef\u89c1\u5ea6\uff0c\u5efa\u8bae\u5b8c\u6210\u4ee5\u4e0b\u6838\u5fc3\u8bbe\u7f6e\uff1a 1. \u4e2a\u4eba\u8d44\u6599\u7167\u7247\uff08Profile Picture\uff09     - \u5efa\u8bae\u5c3a\u5bf8\uff1a\u6700\u4f73\u4e0a\u4f20\u5c3a\u5bf8\u4e3a 320 x 320 \u50cf\u7d20\u3002     - \u663e\u793a\u5c3a\u5bf8\uff1a\u5728\u7535\u8111\u7aef\u663e\u793a\u4e3a 176x176 \u50cf\u7d20\uff0c\u5728\u667a\u80fd\u624b\u673a\u4e0a\u663e\u793a\u4e3a 196x196 \u50cf\u7d20\u3002     - \u88c1\u526a\u65b9\u5f0f\uff1a\u867d\u7136\u4e0a\u4f20\u7684\u662f\u65b9\u5f62\u56fe\u7247\uff0c\u4f46 Facebook \u4f1a\u5c06\u5176\u88c1\u526a\u4e3a\u5706\u5f62\u3002\u56e0\u6b64\uff0c\u8bf7\u786e\u4fdd\u91cd\u8981\u7684\u6587\u5b57\u6216 Logo \u4f4d\u4e8e\u56fe\u7247\u7684\u6b63\u4e2d\u5fc3\uff0c\u4ee5\u514d\u88ab\u5207\u6389\u3002     - \u6587\u4ef6\u683c\u5f0f\uff1a\u5982\u679c\u5305\u542b Logo \u6216\u6587\u5b57\uff0c\u5efa\u8bae\u4f7f\u7528 PNG \u683c\u5f0f\u4ee5\u83b7\u5f97\u66f4\u6e05\u6670\u7684\u6548\u679c\u3002 2. \u5c01\u9762\u7167\u7247\uff08Cover Photo\uff09\u3002     - \u5efa\u8bae\u5c3a\u5bf8\uff1a\u6700\u4f73\u4e0a\u4f20\u5c3a\u5bf8\u4e3a 851 x 315 \u50cf\u7d20\u3002     - \u663e\u793a\u6bd4\u4f8b\u5dee\u5f02\uff1a         - \u7535\u8111\u7aef\uff1a\u4ee5 16:9 \u7684\u6bd4\u4f8b\u663e\u793a\u3002         - \u79fb\u52a8\u7aef\uff1a\u4ee5 2.4:1 \u7684\u6bd4\u4f8b\u663e\u793a\u3002         - \u5b89\u5168\u533a\u57df\uff1a\u7531\u4e8e\u7535\u8111\u548c\u624b\u673a\u7684\u663e\u793a\u6bd4\u4f8b\u4e0d\u540c\uff0c\u5efa\u8bae\u5c06\u91cd\u8981\u7684\u89c6\u89c9\u5143\u7d20\uff08\u5982\u8054\u7cfb\u65b9\u5f0f\u3001Slogan\uff09\u653e\u5728\u56fe\u7247\u7684\u4e2d\u5fc3\u533a\u57df\u3002         - \u6ce8\u610f\uff1a\u5728\u624b\u673a\u7aef\uff0c\u5934\u50cf\u4f1a\u906e\u6321\u5c01\u9762\u56fe\u5de6\u4fa7\u7ea6 40 \u50cf\u7d20\u7684\u533a\u57df\u3002\u8003\u8651\u5934\u50cf\u5728\u5de6\u4fa7\u7684\u906e\u6321\u60c5\u51b5\uff0c\u907f\u514d\u5728\u5de6\u4e0b\u89d2\u653e\u7f6e\u5173\u952e\u4fe1\u606f     - \u6587\u4ef6\u9650\u5236\uff1a\u5efa\u8bae\u4f7f\u7528 sRGB JPG \u683c\u5f0f\uff0c\u6587\u4ef6\u5927\u5c0f\u63a7\u5236\u5728 100 KB \u4ee5\u4e0b \u4ee5\u52a0\u5feb\u52a0\u8f7d\u901f\u5ea6\u3002\u540c\u6837\u5730\uff0c\u82e5\u6709\u6587\u5b57\u6216 Logo\uff0c\u5efa\u8bae\u4f7f\u7528 PNG \u683c\u5f0f\u3002     - \u6700\u4f4e\u9650\u5236\uff1a\u56fe\u7247\u5bbd\u5ea6\u81f3\u5c11\u9700\u8fbe\u5230 400 \u50cf\u7d20\uff0c\u9ad8\u5ea6\u81f3\u5c11\u9700\u8fbe\u5230 150 \u50cf\u7d20\u3002 3. \u7f51\u7ad9\uff1a\u6dfb\u52a0\u60a8\u7684\u5b98\u65b9\u7f51\u7ad9\u94fe\u63a5\u3002 4. \u8054\u7cfb\u4fe1\u606f\uff1a\u586b\u5199\u7535\u5b50\u90ae\u7bb1\u3001\u7535\u8bdd\u53f7\u7801\u3002 5. \u586b\u5199\u5b8c\u4fe1\u606f\u540e\u70b9\u51fb\u201c\u5b8c\u6210\u201d     1. </p> <p>\u5b8c\u6210\u540e\u81ea\u52a8\u8df3\u8f6c\u5230 \u7ba1\u7406\u516c\u5171\u4e3b\u9875 \u9875\u9762\uff0c\u70b9\u51fb\u201c\u7f16\u8f91\u201d\u53ef\u8c03\u6574\u521a\u521a\u7684\u516c\u5171\u4e3b\u9875\u8bbe\u7f6e </p>"},{"location":"FAQ/","title":"\u4e2a\u4eba\u4e3b\u9875\u548c\u516c\u5171\u4e3b\u9875\u6709\u4ec0\u4e48\u533a\u522b\uff1f","text":"<p>\u4e2a\u4eba\u4e3b\u9875 \u7528\u4e8e\u5206\u4eab\u4e2a\u4eba\u4fe1\u606f\u3001\u5174\u8da3\u4ee5\u53ca\u4e0e\u4eb2\u53cb\u5efa\u7acb\u8054\u7cfb\u3002\u5b83\u5177\u6709\u8be6\u7ec6\u7684\u9690\u79c1\u63a7\u5236\u9009\u9879\uff0c\u60a8\u53ef\u4ee5\u51b3\u5b9a\u54ea\u4e9b\u5185\u5bb9\u4ec5\u9650\u597d\u53cb\u53ef\u89c1\u3002\u60a8\u5fc5\u987b\u4f7f\u7528\u771f\u5b9e\u59d3\u540d\u521b\u5efa\u4e2a\u4eba\u4e3b\u9875\uff0c\u4e14\u4e00\u4e2a\u4e3b\u9875\u53ea\u80fd\u7531\u4e00\u4e2a\u4eba\u7ba1\u7406\u3002</p> <p>\u516c\u5171\u4e3b\u9875 \u662f\u4e3a\u4f01\u4e1a\u3001\u54c1\u724c\u3001\u827a\u672f\u5bb6\u3001\u516c\u4f17\u4eba\u7269\u6216\u7ec4\u7ec7\u8bbe\u8ba1\u7684\u516c\u5f00\u7a7a\u95f4\uff0c\u7528\u4e8e\u4e0e\u7c89\u4e1d\u6216\u5ba2\u6237\u4e92\u52a8\u3002\u516c\u5171\u4e3b\u9875\u9ed8\u8ba4\u516c\u5f00\uff0c\u4efb\u4f55\u4eba\u90fd\u53ef\u4ee5\u5173\u6ce8\u3002\u5b83\u4e0d\u9700\u8981\u771f\u5b9e\u59d3\u540d\uff0c\u4e14\u652f\u6301\u591a\u4eba\u5171\u540c\u7ba1\u7406\u5e76\u5206\u914d\u4e0d\u540c\u7684\u6743\u9650\u89d2\u8272\u3002\u60a8\u5fc5\u987b\u62e5\u6709\u4e00\u4e2a\u4e2a\u4eba\u4e3b\u9875\u624d\u80fd\u521b\u5efa\u6216\u7ba1\u7406\u516c\u5171\u4e3b\u9875\u3002</p> <p>\u6838\u5fc3\u533a\u522b\u5bf9\u6bd4 - \u7ba1\u7406\u6743\u9650\uff1a\u4e2a\u4eba\u4e3b\u9875\u4ec5\u9650\u672c\u4eba\u7ba1\u7406\uff1b\u516c\u5171\u4e3b\u9875\u652f\u6301\u591a\u540d\u7ba1\u7406\u5458\u3002 - \u9690\u79c1\u8bbe\u7f6e\uff1a\u4e2a\u4eba\u4e3b\u9875\u53ef\u8bbe\u7f6e\u4ec5\u9650\u597d\u53cb\uff1b\u516c\u5171\u4e3b\u9875\u65e8\u5728\u9762\u5411\u516c\u4f17\u3002 - \u529f\u80fd\u5de5\u5177\uff1a\u516c\u5171\u4e3b\u9875\u63d0\u4f9b\u66f4\u5f3a\u5927\u7684\u54c1\u724c\u63a8\u5e7f\u3001\u5e7f\u544a\u6295\u653e\u548c\u53d7\u4f17\u5206\u6790\u5de5\u5177</p>"}]}